# Copy to .env (repo root, used by docker compose) and/or backend/.env (used by run.py).
# Every value is optional; defaults come from backend/config.yaml.

# PPE_CONFIG=/path/to/another/config.yaml
# PPE_HOST=0.0.0.0
# PPE_PORT=8000
# PPE_MODEL_WEIGHTS=../models/safesight/best.pt
# PPE_DEVICE=auto            # auto | cpu | cuda | cuda:0 | intel:gpu | intel:cpu
# PPE_IMGSZ=480              # full-frame inference size on GPU / iGPU
# PPE_CPU_IMGSZ=480          # inference size on CPU only
# PPE_VIDEOS_DIR=../videos
# PPE_DB_PATH=./data/violations.db   # SQLite violations history
# PPE_LOG_LEVEL=INFO
# TZ=Asia/Kolkata            # plant time zone for "violations today" and CSV local times (docker default: UTC)

# --- authentication (REQUIRED in production) ---
# Secret that signs the access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it the server uses a random per-process secret (everyone is signed out on restart);
# docker compose refuses to start without it.
PPE_JWT_SECRET=
# PPE_ACCESS_TOKEN_MINUTES=15      # access token lifetime (kept in browser memory only)
# PPE_REFRESH_SESSION_HOURS=12     # refresh session without "remember me" (idle timeout)
# PPE_REFRESH_REMEMBER_DAYS=30     # refresh session with "remember me"
# PPE_COOKIE_SECURE=auto           # auto = Secure cookie when served over https; true behind a TLS proxy

# docker build: torch wheel index (cpu | cu124 | ...)
# TORCH_INDEX=cpu

# frontend dev server (frontend/.env)
# VITE_BACKEND_URL=http://127.0.0.1:8000
